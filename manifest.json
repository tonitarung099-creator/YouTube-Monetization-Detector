{
  "manifest_version": 3,
  "name": "YouTube Monetization Detector",
  "version": "0.2.0",
  "description": "Menampilkan indikator monetisasi channel YouTube berdasarkan sinyal publik yang dapat diverifikasi.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Monetization Detector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["detector.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
